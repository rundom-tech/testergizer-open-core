{
  "id": "auth/login",
  "reusable": true,
  "steps": [
    { "type": "goto", "url": "{{BASE_URL}}" },
    { "type": "fill", "target": "login.username", "value": "{{USERNAME}}" },
    { "type": "fill", "target": "login.password", "value": "{{PASSWORD}}" },
    { "type": "click", "target": "login.submit" }
  ]
}
