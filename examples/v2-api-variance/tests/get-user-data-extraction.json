{
  "id": "run-get-user-data-extraction",
  "name": "Verify API Sequential State Chaining",
  "testDomain": "system",
  "inputs": {
    "USER_ID": "1"
  },
  "steps": [
    {
      "id": "step-1-extract-profile",
      "action": "api-call",
      "target": "T-USER-PROFILE",
      "method": "GET",
      "extract": [
        {
          "as": "capturedUserId",
          "path": "$.id",
          "transform": "number"
        }
      ],
      "assertions": [
        { "check": "status_code", "expected": 200 }
      ]
    },
    {
      "id": "step-2-inject-post",
      "action": "api-call",
      "target": "T-USER-POSTS",
      "method": "POST",
      "payload": {
        "title": "Chaining Proof",
        "body": "This payload uses an ID extracted from the previous step.",
        "userId": "{{capturedUserId}}"
      },
      "group": { "name": "Sequential Injection Verification" },
      "assertions": [
        { "check": "status_code", "expected": 201 },
        { "check": "json_path", "path": "$.userId", "expected": "{{capturedUserId}}" }
      ]
    }
  ]
}