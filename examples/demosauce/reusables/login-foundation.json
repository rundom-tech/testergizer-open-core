{
  "id": "login-foundation",
  "reusable": true,
  "steps": [
    {
      "id": "step_0",
      "type": "NAVIGATE",
      "value": "https://www.saucedemo.com"
    },
    {
      "id": "step_1",
      "type": "fill",
      "target": "username.edit",
      "value": "{{param_username}}"
    },
    {
      "id": "step_2",
      "type": "fill",
      "target": "password.edit",
      "value": "{{param_password}}"
    },
    {
      "id": "step_3",
      "type": "click",
      "target": "loginButton.button",
      "assertions": [
        {
          "type": "EXPECT_URL",
          "value": "https://www.saucedemo.com/inventory.html"
        }
      ]
    }
  ]
}