{
  "id": "saucedemo.login.smoke",
  "context": {
    "BASE_URL": "https://www.saucedemo.com",
    "USERNAME": { "$secret": "SAUCEDEMO_USERNAME" },
    "PASSWORD": { "$secret": "SAUCEDEMO_PASSWORD" }
  },
  "steps": [
    { "type": "include", "ref": "auth/login" },
    { "type": "assertVisible", "target": "inventory.title" },
    { "type": "include", "ref": "auth/logout" },
    { "type": "assertVisible", "target": "login.button" }
  ]
}
