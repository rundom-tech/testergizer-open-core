{
  "schemaVersion": "v1",
  "appId": "demosauce",
  "appName": "SauceDemo",
  "versionRange": "demo",
  "locators": {
    "login.username.edit": {
      "contexts": ["login"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"username\"]" },
        { "using": "css", "value": "#user-name" }
      ]
    },
    "login.password.edit": {
      "contexts": ["login"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"password\"]" },
        { "using": "css", "value": "#password" }
      ]
    },
    "login.submit.button": {
      "contexts": ["login"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"login-button\"]" },
        { "using": "css", "value": "#login-button" }
      ]
    },
    "login.error.banner": {
      "contexts": ["login"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"error\"]" },
        { "using": "css", "value": ".error-message-container" }
      ]
    },

    "inventory.cart.link": {
      "contexts": ["inventory", "cart", "checkout"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"shopping-cart-link\"]" },
        { "using": "css", "value": "a.shopping_cart_link" }
      ]
    },
    "inventory.cart.badge": {
      "contexts": ["inventory", "cart", "checkout"],
      "selectors": [
        { "using": "css", "value": ".shopping_cart_badge" }
      ]
    },
    "inventory.sort.select": {
      "contexts": ["inventory"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"product-sort-container\"]" },
        { "using": "css", "value": ".product_sort_container" }
      ]
    },
    "inventory.items.container": {
      "contexts": ["inventory"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"inventory-container\"]" },
        { "using": "css", "value": "#inventory_container" }
      ]
    },

    "inventory.item.backpack.add.button": {
      "contexts": ["inventory"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"add-to-cart-sauce-labs-backpack\"]" },
        { "using": "css", "value": "#add-to-cart-sauce-labs-backpack" }
      ]
    },
    "inventory.item.backpack.remove.button": {
      "contexts": ["inventory"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"remove-sauce-labs-backpack\"]" },
        { "using": "css", "value": "#remove-sauce-labs-backpack" }
      ]
    },

    "cart.items.container": {
      "contexts": ["cart"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"cart-list\"]" },
        { "using": "css", "value": ".cart_list" }
      ]
    },
    "cart.checkout.button": {
      "contexts": ["cart"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"checkout\"]" },
        { "using": "css", "value": "#checkout" }
      ]
    },
    "cart.continueShopping.button": {
      "contexts": ["cart"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"continue-shopping\"]" },
        { "using": "css", "value": "#continue-shopping" }
      ]
    },

    "checkout.firstName.edit": {
      "contexts": ["checkoutInfo"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"firstName\"]" },
        { "using": "css", "value": "#first-name" }
      ]
    },
    "checkout.lastName.edit": {
      "contexts": ["checkoutInfo"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"lastName\"]" },
        { "using": "css", "value": "#last-name" }
      ]
    },
    "checkout.postalCode.edit": {
      "contexts": ["checkoutInfo"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"postalCode\"]" },
        { "using": "css", "value": "#postal-code" }
      ]
    },
    "checkout.continue.button": {
      "contexts": ["checkoutInfo"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"continue\"]" },
        { "using": "css", "value": "#continue" }
      ]
    },
    "checkout.cancel.button": {
      "contexts": ["checkoutInfo", "checkoutOverview"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"cancel\"]" },
        { "using": "css", "value": "#cancel" }
      ]
    },

    "checkout.finish.button": {
      "contexts": ["checkoutOverview"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"finish\"]" },
        { "using": "css", "value": "#finish" }
      ]
    },
    "checkout.complete.header": {
      "contexts": ["checkoutComplete"],
      "selectors": [
        { "using": "css", "value": "[data-test=\"complete-header\"]" },
        { "using": "css", "value": ".complete-header" }
      ]
    }
  }
}