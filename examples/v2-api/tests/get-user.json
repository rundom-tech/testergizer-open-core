{
  "id": "API-V2-001",
  "name": "Verify JSONPlaceholder User Profile",
  "testDomain": "api",
  "steps": [
    {
      "id": "get-profile",
      "action": "api-call",
      "target": "T-USER-PROFILE",
      "method": "GET",
      "assertions": [
        {
          "check": "status_code",
          "expected": 200
        },
        {
          "check": "json_path",
          "path": "$.name",
          "expected": "Leanne Graham"
        },
        {
          "check": "json_path",
          "path": "$.email",
          "expected": "Sincere@april.biz"
        }
      ]
    }
  ]
}