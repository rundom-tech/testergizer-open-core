{
  "$id": "https://testergizer.dev/schemas/executable.schema.json",
  "title": "Testergizer Executable",
  "type": "object",
  "additionalProperties": true,
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "reusable": { "type": "boolean", "default": false },

    "apiDefinition": {
      "type": "object",
      "additionalProperties": true,
      "description": "Used for API domain testing, bypassing traditional UI steps."
    },

    "context": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" },
          {
            "type": "object",
            "required": ["$secret"],
            "additionalProperties": false,
            "properties": {
              "$secret": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
            }
          }
        ]
      }
    },

    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "type": { "type": "string" },
          "ref": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "include" } }, "required": ["type"] },
            "then": { "required": ["ref"], "additionalProperties": true }
          }
        ]
      }
    }
  },

  "anyOf": [
    { "required": ["steps"] },
    { "required": ["apiDefinition"] }
  ],

  "allOf": [
    {
      "if": {
        "properties": { "reusable": { "const": true } },
        "required": ["reusable"]
      },
      "then": {
        "not": { "required": ["context"] }
      }
    }
  ]
}