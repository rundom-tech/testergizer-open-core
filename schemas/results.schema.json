{
  "$id": "https://testergizer.dev/schemas/results.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "suiteId",
    "executionMode",
    "startedAt",
    "endedAt",
    "durationMs",
    "tests",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "v1" },
    "runId": { "type": "string" },
    "suiteId": { "type": "string" },
    "suiteName": { "type": "string" },
    "suitePath": { "type": "string" },
    "executionMode": { "type": "string", "enum": ["stub", "execute", "baseline"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "tests": { "type": "array", "items": { "$ref": "#/$defs/testResult" } },
    "summary": { "$ref": "#/$defs/runSummary" }
  },
  "$defs": {
    "testResult": {
      "type": "object",
      "required": [
        "id",
        "testDomain",
        "executionMode",
        "status",
        "startedAt",
        "endedAt",
        "durationMs",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "testDomain": { "type": "string", "enum": ["ui", "api", "system"] },
        "executionMode": { "type": "string", "enum": ["stub", "execute", "baseline"] },
        "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/stepResult" } }
      }
    },
    "stepResult": {
      "type": "object",
      "required": [
        "id",
        "action",
        "status",
        "attempts",
        "errors",
        "startedAt",
        "endedAt",
        "durationMs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
        "attempts": { "type": "integer", "minimum": 1 },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason", "message"],
            "additionalProperties": false,
            "properties": {
              "reason": { "type": "string" },
              "message": { "type": "string" },
              "stack": { "type": "string" }
            }
          }
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "runSummary": {
      "type": "object",
      "required": ["total", "passed", "failed", "skipped"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
