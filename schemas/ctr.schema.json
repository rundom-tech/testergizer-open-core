{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://testergizer.dev/schemas/ctr.schema.json",
  "title": "Common Language Resources (CLR) - Target Registry",
  "description": "Schema for reusable, context-scoped targets (UI Locators, API Endpoints, and System Paths)",

  "type": "object",
  "required": ["id"],
  "additionalProperties": false,

  "properties": {
    "id": { "type": "string" },
    "description": { "type": "string" },
    "domain": {
      "type": "string",
      "enum": ["WEB", "REST", "FS", "DB", "EMAIL"],
      "default": "WEB"
    },

    "locators": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/locator"
      }
    },
    
    "endpoints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/endpoint"
      }
    },

    "paths": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/systemPath"
      }
    }
  },

  "anyOf": [
    { "required": ["locators"] },
    { "required": ["endpoints"] },
    { "required": ["paths"] }
  ],

  "definitions": {
    "locator": {
      "type": "object",
      "required": ["selectors"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["firstMatch"],
          "default": "firstMatch"
        },
        "contexts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Contexts in which this locator is valid"
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/selector" }
        }
      }
    },

    "selector": {
      "type": "object",
      "required": ["using", "value"],
      "additionalProperties": false,
      "properties": {
        "using": {
          "type": "string",
          "enum": ["css", "xpath", "text", "role", "testid"]
        },
        "value": { "type": "string" }
      }
    },

    "endpoint": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { 
          "type": "string",
          "description": "The target endpoint URL or path, supporting {{variable}} injection"
        },
        "defaultMethod": { 
          "type": "string",
          "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] 
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "systemPath": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "description": "The file or directory path, supporting {{variable}} injection"
        },
        "type": {
          "type": "string",
          "enum": ["file", "directory", "symlink"]
        }
      }
    }
  }
}