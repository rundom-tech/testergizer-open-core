{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://testergizer.dev/schemas/clr.schema.json",
  "title": "Central Locators Repository (CLR)",
  "description": "Schema for reusable, context-scoped UI locators",

  "type": "object",
  "required": ["id", "locators"],
  "additionalProperties": false,

  "properties": {
    "id": { "type": "string" },
    "description": { "type": "string" },

    "locators": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/locator"
      }
    }
  },

  "definitions": {
    "locator": {
      "type": "object",
      "required": ["selectors"],
      "additionalProperties": false,

      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["firstMatch"],
          "default": "firstMatch"
        },

        "contexts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Contexts in which this locator is valid"
        },

        "selectors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/selector" }
        }
      }
    },

    "selector": {
      "type": "object",
      "required": ["using", "value"],
      "additionalProperties": false,

      "properties": {
        "using": {
          "type": "string",
          "enum": ["css", "xpath", "text", "role", "testid"]
        },
        "value": { "type": "string" }
      }
    }
  }
}
