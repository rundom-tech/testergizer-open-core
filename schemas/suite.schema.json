{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testergizer.dev/schemas/suite.schema.json",
  "type": "object",
  "required": ["schemaVersion", "suiteId", "suiteName", "tests"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "v1" },
    "suiteId": { "type": "string" },
    "suiteName": { "type": "string" },
    "baseUrl": { "type": "string", "format": "uri" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/test" }
    }
  },
  "$defs": {
    "test": {
      "type": "object",
      "required": ["id", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "testDomain": { "type": "string", "enum": ["ui", "api", "system"] },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "action": {
          "type": "string",
          "enum": ["goto", "click", "fill", "assertVisible", "assertText", "waitFor"]
        },
        "target": { "type": "string" },
        "value": { "type": ["string", "number", "boolean"] },
        "timeoutMs": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "goto" } } },
          "then": { "required": ["target"], "properties": { "target": { "type": "string","format": "uri" } } }
        },
        {
          "if": { "properties": { "action": { "enum": ["click", "fill", "assertVisible", "assertText"] } } },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "action": { "const": "fill" } } },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["value"]
          }
        },
        {
          "if": { "properties": { "action": { "const": "assertText" } } },
          "then": { "required": ["value"] }
        }
      ]
    }
  }
}
